---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import "../styles/reset.css";
import "../styles/global.css";

const {
  pageTitle,
  ogImage,
  description = SITE_DESCRIPTION,
  type = "website",
} = Astro.props;

const defaultTitle = "Un blog random de tharandur";
const siteUrl = Astro.site ?? new URL("https://tharandur.sbs");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const rssUrl = new URL("/rss.xml", siteUrl).toString();
const fullOgImageUrl = new URL(ogImage ?? "/android-chrome-512x512.png", siteUrl).toString();
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle ?? defaultTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={rssUrl} />

    <meta property="og:title" content={pageTitle ?? defaultTitle} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle ?? defaultTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImageUrl} />
  </head>
  <body>
    <div class="main-wrapper">
      <Header />
      <div class="content">
        {pageTitle && <h1 class="content__title">{pageTitle}</h1>}
        <slot />
      </div>
    </div>
    <Footer />
  </body>
</html>
