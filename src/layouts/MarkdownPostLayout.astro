---
const { frontmatter, ogImage } = Astro.props;
import BaseLayout from "./BaseLayout.astro";
import { DEVLOG } from "../consts";
import "./post-layout.css";

const isDevlog = frontmatter.tags?.includes(DEVLOG.tag);
---

<BaseLayout
  pageTitle={frontmatter.title}
  ogImage={ogImage}
  description={frontmatter.description}
  type="article"
>
  <p class="post-date">
    {isDevlog && <><a href={DEVLOG.url}>{DEVLOG.title}</a> · </>}
    <time datetime={frontmatter.pubDate.toISOString().split("T")[0]}>
      {
        frontmatter.pubDate.toLocaleDateString("es-ES", {
          day: "2-digit",
          month: "2-digit",
          year: "numeric",
        })
      }
    </time>
  </p>
  {
    frontmatter.translatable && (
      <p class="post-translation">
        <a
          lang="en"
          href={`https://tharandur-sbs.translate.goog${Astro.url.pathname}?_x_tr_sl=es&_x_tr_tl=en`}
        >
          Read in English
        </a>
      </p>
    )
  }
  <article class="post-content">
    <slot />
  </article>
</BaseLayout>
