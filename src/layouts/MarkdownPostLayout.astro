---
const { frontmatter, ogImage } = Astro.props;
import BaseLayout from "./BaseLayout.astro";
import { DEVLOG } from "../consts";
import "./post-layout.css";

const isDevlog = frontmatter.tags?.includes(DEVLOG.tag);
---

<BaseLayout
  pageTitle={frontmatter.title}
  ogImage={ogImage}
  description={frontmatter.description}
  type="article"
>
  <p class="post-date">
    {isDevlog && <><a href={DEVLOG.url}>{DEVLOG.title}</a> · </>}
    {frontmatter.pubDate.toLocaleDateString()}
  </p>
  <main class="post-content">
    <slot />
  </main>
</BaseLayout>
